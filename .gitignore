# Rust / Cargo build outputs
/target/
/target-*/
/target_*/

# Generated logs and captures
/logs/
*.log

# Temporary output
/tmp/
/temp/
*.tmp

# IDE caches
/.cursor/index/
/.cursor/cache/
/.vscode/
/.idea/

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Generated asset/cache directories
/assets/generated/
/assets/cache/

# Monster pack local diagnostics (large GLBs; manifests/PNGs may be committed)
/tools/monster_pack/diagnostics/**/*.glb
/tools/monster_pack/__pycache__/
/tools/monster_pack/_audit_*.glb
